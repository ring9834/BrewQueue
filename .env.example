# Copy to .env (which is git-ignored) and change every value before using this anywhere shared.
# Use letters and digits only: some values end up inside JAAS config strings.
#
# Production: these come from a secret manager (Vault, AWS Secrets Manager, Azure Key Vault,
# Kubernetes Secrets), never from a file in the repository.

# Password protecting the TLS keystores and truststore generated in infra/kafka/secrets/
CERT_PASSWORD=ChangeMeCerts1

# Kafka SCRAM users. `admin` is a super user, bootstrapped when the brokers are first formatted.
KAFKA_ADMIN_PASSWORD=ChangeMeKafkaAdmin1
KAFKA_API_PASSWORD=ChangeMeKafkaApi1
KAFKA_STATS_PASSWORD=ChangeMeKafkaStats1
KAFKA_SCHEMA_REGISTRY_PASSWORD=ChangeMeKafkaSr1
KAFKA_UI_PASSWORD=ChangeMeKafkaUi1
KAFKA_EXPORTER_PASSWORD=ChangeMeKafkaExporter1

# Schema Registry HTTP Basic users
SR_ADMIN_PASSWORD=ChangeMeSrAdmin1
SR_API_PASSWORD=ChangeMeSrApi1
SR_UI_PASSWORD=ChangeMeSrUi1

# Login for the Kafka UI web page (user name: admin)
KAFKA_UI_LOGIN_PASSWORD=ChangeMeUiLogin1
