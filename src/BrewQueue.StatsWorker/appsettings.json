{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=brewqueue;Username=brewqueue;Password=brewqueue"
  },
  "Kafka": {
    "BootstrapServers": "localhost:19092,localhost:19093,localhost:19094",
    "SecurityProtocol": "SaslSsl",
    "SaslMechanism": "ScramSha512",
    "SaslUsername": "stats",
    "SaslPassword": "",
    "SslCaLocation": "infra/kafka/secrets/public/ca.crt",
    "ConsumerGroupId": "brewqueue-stats",
    "GroupInstanceId": "",
    "ManageTopics": false,
    "Processing": {
      "MaxAttempts": 3,
      "InitialRetryDelay": "00:00:00.200"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Service} {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ]
  }
}
