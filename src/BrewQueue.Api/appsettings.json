{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=brewqueue;Username=brewqueue;Password=brewqueue",
    "Redis": "localhost:6379"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "brewqueue",
    "Password": "brewqueue"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "OrderEventsPartitions": 3
  },
  "Idempotency": {
    "LockTtl": "00:00:30",
    "ResponseTtl": "1.00:00:00"
  },
  "Cors": {
    "Origins": [ "http://localhost:3000" ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Service} {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ]
  },
  "AllowedHosts": "*"
}
